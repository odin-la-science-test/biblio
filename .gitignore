```gitignore
# Python byte-code and cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/

# Dependencies
pip/
setuptools/
wheel/

# Logs
*.log

# Environment variables
.env
.env.local
.env.*

# IDE specific
.vscode/
.idea/

# Coverage reports
.coverage
htmlcov/
coverage/

# Pytest cache
.pytest_cache/

# MyPy cache
.mypy_cache/

# Build artifacts
dist/
build/
*.egg-info/

# Compression files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```